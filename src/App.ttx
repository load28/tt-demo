import { useEffect, useState, type FormEvent } from "react";
import type { TOption } from "@tt/std";
import * as Option from "@tt/std/option";

import {
  Action,
  Filter,
  Priority,
  TodoError,
  type Todo,
  cyclePriority,
  describeAction,
  describeError,
  dueBadge,
  dueStatusOf,
  emptyMessage,
  filterLabel,
  parseTodo,
  priorityLabel,
  progressLabel,
  progressOf,
  sortTodos,
  undoAction,
  visibleTodos,
} from "./todo.tt";
import {
  LEGACY_KEY,
  LoadError,
  STORAGE_KEY,
  describeLoadError,
  describeSaveError,
  loadTodos,
  saveTodos,
} from "./storage.tt";
import {
  SyncState,
  describeSync,
  syncWithRetry,
  type SyncPort,
} from "./sync.tt";

/** 가짜 서버 — 250ms 지연 후 저장 시각을 돌려줍니다. */
const fakeServer: SyncPort = async (payload) => {
  await new Promise<void>((resolve) => setTimeout(resolve, 250));
  const count = JSON.parse(payload) as number;
  return `${count}개 · ${new Date().toLocaleTimeString("ko-KR")}`;
};

const backoff = (attempt: number): Promise<void> =>
  new Promise<void>((resolve) => setTimeout(resolve, 150 * attempt));

val const FILTERS: readonly Filter[] = [
  Filter.All,
  Filter.Active,
  Filter.Completed,
];

/** 로컬 달력 기준 오늘 ("YYYY-MM-DD") — UTC(toISOString) 사용 시 자정 부근 오차. */
const todayLocal = (): string => {
  const now = new Date();
  const month = String(now.getMonth() + 1).padStart(2, "0");
  const day = String(now.getDate()).padStart(2, "0");
  return `${now.getFullYear()}-${month}-${day}`;
};

/** 모듈 로드 시 한 번만 읽고, 아래 초기값들이 같은 결과를 나눠 씁니다. */
const initialLoad = loadTodos();

const initialTodos: readonly Todo[] = match (initialLoad) {
  Ok(value: outcome) => outcome.todos,
  Err => [],
};

/** 로드 결과에서 사용자에게 알릴 것들 (마이그레이션·부분 복구·실패). */
const initialNotices: readonly string[] = match (initialLoad) {
  Ok(value: outcome) => {
    const notes: string[] = [];
    if let Some(value: from) = outcome.migratedFrom {
      notes.push(`이전 형식(v${from})의 목록을 자동으로 옮겨왔어요.`);
    }
    if (outcome.skipped > 0) {
      notes.push(`손상된 항목 ${outcome.skipped}개를 제외하고 불러왔어요.`);
    }
    return notes;
  },
  Err(error: e) => [describeLoadError(e)],
};

/**
 * 더 새로운 형식(FutureVersion)의 데이터가 있으면 이 화면의 저장을 전부 막아
 * 최신 데이터를 덮어쓰지 않습니다 — 중첩 패턴으로 판정.
 */
const saveBlocked: boolean = match (initialLoad) {
  Err(error: FutureVersion) => true,
  _ => false,
};

const nextIdOf = (todos: readonly Todo[]): number =>
  todos.reduce((max, todo) => Math.max(max, todo.id), 0) + 1;

export default function App() {
  const [todos, setTodos] = useState<readonly Todo[]>(initialTodos);
  const [history, setHistory] = useState<readonly Action[]>([]);
  const [draft, setDraft] = useState("");
  const [draftDue, setDraftDue] = useState("");
  const [filter, setFilter] = useState<Filter>(Filter.All);
  const [error, setError] = useState<TOption<TodoError>>(Option.None);
  const [saveNotice, setSaveNotice] = useState<TOption<string>>(Option.None);
  const [externalChange, setExternalChange] = useState(false);
  const [sync, setSync] = useState<SyncState>(SyncState.Idle);

  const syncNow = async () => {
    setSync(SyncState.Syncing(1));
    setSync(
      await syncWithRetry(fakeServer, JSON.stringify(todos.length), 3, backoff),
    );
  };

  useEffect(() => {
    if (saveBlocked) { return; }
    if let Err(error: e) = saveTodos(todos) {
      setSaveNotice(Option.Some(describeSaveError(e)));
    } else {
      setSaveNotice(Option.None);
    }
  }, [todos]);

  /** 다른 탭이 같은 목록을 저장하면 알리고 새로고침을 권합니다. */
  useEffect(() => {
    const onStorage = (event: StorageEvent) => {
      if (event.key === STORAGE_KEY || event.key === LEGACY_KEY) {
        setExternalChange(true);
      }
    };
    window.addEventListener("storage", onStorage);
    return () => window.removeEventListener("storage", onStorage);
  }, []);

  const commit = (next: readonly Todo[], action: Action) => {
    setTodos(next);
    setHistory([...history, action]);
  };

  const addTodo = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    // ttc 현재 버전은 문(statement) 위치의 단독 match에서 ICE가 나므로(이슈 #1)
    // return으로 감쌉니다.
    return match (parseTodo(draft, todos)) {
      Ok(value: text) => {
        const id = nextIdOf(todos);
        const due: TOption<string> =
          draftDue === "" ? Option.None : Option.Some(draftDue);
        commit(
          [...todos, { id, text, done: false, priority: Priority.Medium, due }],
          Action.Added(id),
        );
        setDraft("");
        setDraftDue("");
        setError(Option.None);
      },
      Err(error: e) => {
        setError(Option.Some(e));
      },
    };
  };

  const toggleTodo = (id: number) =>
    commit(
      todos.map((todo) =>
        todo.id === id ? { ...todo, done: !todo.done } : todo,
      ),
      Action.Toggled(id),
    );

  const removeTodo = (id: number) => {
    const index = todos.findIndex((todo) => todo.id === id);
    const Some(value: removed) = Option.fromNullable(todos[index] ?? null) else {
      return;
    };
    commit(
      todos.filter((todo) => todo.id !== id),
      Action.Removed(removed, index),
    );
  };

  const reprioritize = (id: number) => {
    const Some(value: target) = Option.fromNullable(
      todos.find((todo) => todo.id === id) ?? null,
    ) else {
      return;
    };
    commit(
      todos.map((todo) =>
        todo.id === id
          ? { ...todo, priority: cyclePriority(todo.priority) }
          : todo,
      ),
      Action.Reprioritized(id, target.priority),
    );
  };

  const clearDone = () => {
    const removed = todos.filter((todo) => todo.done);
    if (removed.length === 0) { return; }
    commit(
      todos.filter((todo) => !todo.done),
      Action.ClearedDone(removed),
    );
  };

  const undoLast = () => {
    const Some(value: last) = Option.fromNullable(
      history[history.length - 1] ?? null,
    ) else {
      return;
    };
    setTodos(undoAction(todos, last));
    setHistory(history.slice(0, -1));
  };

  const today = todayLocal();
  const shown = sortTodos(visibleTodos(todos, filter), today);
  const progress = progressOf(todos);
  const remaining = todos.filter((todo) => !todo.done).length;
  const doneCount = todos.length - remaining;

  // JSX 컨테이너 안 match는 앞 형제 요소를 잘못 로워링하므로(이슈 #2)
  // 전부 return 전에 값으로 계산합니다.
  const errorView = match (error) {
    Some(value: e) => <p className="error">{describeError(e)}</p>,
    None => null,
  };
  const saveNoticeView = match (saveNotice) {
    Some(value: message) => <p className="notice warn">{message}</p>,
    None => null,
  };
  const emptyView = match (emptyMessage(filter, progress)) {
    Some(value: message) => <p className="empty">{message}</p>,
    None => null,
  };
  const undoTitle = match (Option.fromNullable(
    history[history.length - 1] ?? null,
  )) {
    Some(value: last) => describeAction(last),
    None => "되돌릴 변경이 없어요",
  };
  const syncBusy = sync.kind === "Syncing";
  const syncView = match (sync) {
    Idle => null,
    Failed => <span className="sync fail">{describeSync(sync)}</span>,
    _ => <span className="sync">{describeSync(sync)}</span>,
  };

  const rows = shown.map((todo) => {
    const badge = match (dueBadge(dueStatusOf(todo, today))) {
      Some(value: text) => (
        <span className={`due ${dueStatusOf(todo, today).kind.toLowerCase()}`}>
          {text}
        </span>
      ),
      None => null,
    };
    return (
      <li key={todo.id} className={todo.done ? "done" : ""}>
        <label>
          <input
            type="checkbox"
            checked={todo.done}
            onChange={() => toggleTodo(todo.id)}
          />
          <span>{todo.text}</span>
        </label>
        <span className="actions">
          {badge}
          <button
            type="button"
            className={`priority ${todo.priority.kind.toLowerCase()}`}
            onClick={() => reprioritize(todo.id)}
            title="우선순위 바꾸기"
          >
            {priorityLabel(todo.priority)}
          </button>
          <button
            type="button"
            className="remove"
            onClick={() => removeTodo(todo.id)}
            aria-label={`"${todo.text}" 삭제`}
          >
            ×
          </button>
        </span>
      </li>
    );
  });

  return (
    <main className="app">
      <header className="top">
        <h1>tt todo</h1>
        <span className="header-actions">
          <button
            type="button"
            className="undo"
            onClick={syncNow}
            disabled={syncBusy}
          >
            ⇅ 동기화
          </button>
          <button
            type="button"
            className="undo"
            onClick={undoLast}
            disabled={history.length === 0}
            title={undoTitle}
          >
            ↩ {undoTitle}
          </button>
        </span>
      </header>
      {syncView}
      <p className="tagline">
        <code>variant</code> · <code>match</code> · <code>try</code> ·{" "}
        <code>result</code> · <code>|&gt;</code> · <code>flow</code>로 만든 투두 앱
      </p>

      {initialNotices.map((note) => (
        <p key={note} className={saveBlocked ? "notice warn" : "notice"}>
          {note}
        </p>
      ))}
      {saveNoticeView}
      {externalChange && (
        <p className="notice warn">
          다른 탭에서 목록이 바뀌었어요.{" "}
          <button
            type="button"
            className="reload"
            onClick={() => location.reload()}
          >
            새로고침
          </button>
        </p>
      )}

      <form className="add" onSubmit={addTodo}>
        <input
          value={draft}
          onChange={(event) => {
            setDraft(event.target.value);
            setError(Option.None);
          }}
          placeholder="무엇을 해야 하나요?"
          aria-label="새 할 일"
        />
        <input
          type="date"
          value={draftDue}
          onChange={(event) => setDraftDue(event.target.value)}
          aria-label="마감일"
        />
        <button type="submit">추가</button>
      </form>

      {errorView}

      <div className="toolbar">
        <div className="filters" role="group" aria-label="필터">
          {FILTERS.map((option) => (
            <button
              key={option.kind}
              type="button"
              className={option.kind === filter.kind ? "active" : ""}
              onClick={() => setFilter(option)}
            >
              {filterLabel(option)}
            </button>
          ))}
        </div>
        {doneCount > 0 && (
          <button type="button" className="clear" onClick={clearDone}>
            완료 {doneCount}개 비우기
          </button>
        )}
      </div>

      <ul className="todos">{rows}</ul>

      {shown.length === 0 ? (
        emptyView
      ) : (
        <p className="summary">{progressLabel(progress, remaining)}</p>
      )}
    </main>
  );
}
