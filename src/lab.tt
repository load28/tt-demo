/**
 * 구문 조합 실험실 — tt 구문을 서로 겹쳐 썼을 때의 의미를 lab.test.ts가
 * 런타임까지 검증합니다. 앱 코드가 아니라 컴파일러 회귀 카나리아입니다.
 */
import type { TOption, TResult } from "@tt/std";
import * as Option from "@tt/std/option";
import * as Result from "@tt/std/result";

/* 1. 제네릭 재귀 variant + 재귀 match + 중첩 패턴 */

export variant Tree<T> {
  Leaf(value: T),
  Node(left: Tree<T>, right: Tree<T>),
}

export const treeSum = (tree: Tree<number>): number =>
  match (tree) {
    Leaf(value) => value,
    Node(left, right) => treeSum(left) + treeSum(right),
  };

/** 중첩 패턴이 제네릭 필드 타입(Tree<T>)을 따라가는지. */
export const leftmostLeafDoubled = (tree: Tree<number>): number =>
  match (tree) {
    Leaf(value) => value * 2,
    Node(left: Leaf(value: v)) => v * 2,
    Node(left) => leftmostLeafDoubled(left),
  };

/* 2. try 값 형태 — 더 큰 표현식 안, 조건식 괄호 전파 */

const half = (n: number): TResult<number, string> =>
  n % 2 === 0 ? Result.Ok(n / 2) : Result.Err("홀수");

export const computeBudget = (n: number): TResult<number, string> => result {
  // 값 형태 try를 result 블록의 return 식 안에 내장하면 ICE(이슈 #6) —
  // const로 먼저 뽑는다. 값 형태의 바인딩 규칙 자체((try half(n)) * 1.1)는
  // 일반 함수 쪽 computeBudgetFn에서 검증.
  const halved = try half(n);
  return Math.round(halved * 1.1);
};

/** 일반 함수(비 result 블록)에서는 내장 값 형태 try가 정상 동작. */
export const computeBudgetFn = (n: number): TResult<number, string> => {
  return Result.Ok(Math.round(try half(n) * 1.1));
};

export const pickEven = (a: number, b: number): TResult<number, string> => result {
  // 임의 식 전파는 괄호로: try (cond ? x : y)
  return try (a % 2 === 0 ? half(a) : half(b));
};

/* 3. 파이프라인: try 헤드, 옵셔널 스텝, flow와 std 커리 스텝 */

// try의 피연산자가 파이프라인인 조합 — result 블록 안에서는 파싱 불가 TS가
// 생성되므로(이슈 #6과 같은 계열) 일반 함수에서 검증하고,
export const normalizedBudget = (n: number): TResult<string, string> => {
  const value = try (half(n) |> Result.mapP((v: number) => v.toFixed(1)));
  return Result.Ok(value);
};

// result 블록 안에서는 try와 파이프라인을 두 문장으로 나눈다.
export const normalizedBudgetBlock = (n: number): TResult<string, string> => result {
  const halved = try half(n);
  const value = halved |> ((v: number) => v.toFixed(1));
  return value;
};

type Profile = { contact?: { email: string } };

/** 옵셔널 포스트픽스 스텝 — 끊겨도 다음 스텝은 undefined로 호출됨. */
export const emailOf = (profile: Profile | null): string =>
  profile
    |> ?.contact
    |> ((c: { email: string } | null | undefined) => Option.fromNullable(c))
    |> Option.mapP((c: { email: string }) => c.email)
    |> Option.unwrapOrP("미등록");

export val const gradeOf = flow
  |> ((score: number) => Math.max(0, Math.min(100, score)))
  |> ((clamped: number) => (clamped >= 90 ? "A" : clamped >= 70 ? "B" : "C"));

/* 4. result 블록의 특수 위치: 템플릿 리터럴 보간, 파이프라인 헤드 */

const price = (sku: string): TResult<number, string> =>
  sku === "A1" ? Result.Ok(1200) : Result.Err(`무명 SKU ${sku}`);

// result 블록을 `|>` 파이프라인 헤드로 쓰면 성공 return이 함수의 실제
// return으로 새는 오컴파일(이슈 #7)이 있다. 함수 인자·템플릿 보간 위치는
// 정상이므로 unwrapOr의 인자로 넘긴다.
export const receiptLine = (sku: string, qty: number): string =>
  `${sku} × ${qty} = ${Result.unwrapOr(
    result {
      const unit = try price(sku);
      return unit * qty;
    },
    0,
  )}원`;

/* 5. match arm 블록 안의 result 블록 (이슈 #4의 역방향 합성) */

export const settle = (order: TOption<string>): number =>
  match (order) {
    Some(value: sku) => {
      const settled = result {
        const unit = try price(sku);
        return unit + 100;
      };
      return Result.unwrapOr(settled, -1);
    },
    None => 0,
  };

/* 6. 튜플 match + 가드 + 곱 완전성 */

export const mergeQuota = (
  mine: TOption<number>,
  team: TOption<number>,
): number =>
  match (mine, team) {
    (Some(value: m), Some(value: t)) if m > t => m,
    (Some, Some(value: t)) => t,
    (Some(value: m), None) => m,
    (None, Some(value: t)) => t,
    (None, None) => 0,
  };

/* 7. 유한 리터럴 유니언의 `_` 없는 리터럴 match (--check-types 완전성 검사 대상) */

export type Toggle = "on" | "off";

export const flip = (t: Toggle): Toggle =>
  match (t) {
    // 로워링 슬롯이 무주석이라 리터럴 arm 값이 반환 문맥 타입을 못 받아
    // string으로 widen된다(이슈 #8) — as const로 리터럴 타입을 지킨다.
    "on" => "off" as const,
    "off" => "on" as const,
  };

/* 8. val 바인딩을 같은 파일의 val 파라미터로 전달 */

const sizeOf = (val items: readonly number[]): number => items.length;

val const BASE_UNITS: readonly number[] = [1, 2, 3];

export const baseSize = (): number => sizeOf(BASE_UNITS);

/* 9. if let + 중첩 패턴, let-else + or-패턴 */

export const firstOkValue = (
  r: TResult<TOption<number>, string>,
): number => {
  if let Ok(value: Some(value: v)) = r {
    return v;
  }
  return -1;
};

export variant Shape {
  Circle(radius: number),
  Square(radius: number),
  Dot,
}

/** let-else + or-패턴 (같은 (필드,이름) 집합). */
export const radiusOrZero = (shape: Shape): number => {
  const Circle(radius) | Square(radius) = shape else {
    return 0;
  };
  return radius;
};

/* 10-a. while 조건의 match — 매 반복 재평가되는 영역 */

export const countdown = (start: number): readonly number[] => {
  let n = start;
  const seen: number[] = [];
  while (match (n) { 0 => false, _ => true }) {
    seen.push(n);
    n -= 1;
  }
  return seen;
};

/* 10-b. 타입 전용 is or-패턴 (바인딩 없음) — 부모(Error)보다 앞에 배치 */

export const errorKind = (error: unknown): string =>
  match (error) {
    is RangeError | is TypeError => "범위/타입",
    is Error { message } => message,
    _ => "알 수 없음",
  };

/* 10-c. variant 없이 손으로 쓴 kind 유니언에 대한 match */

export type Payment =
  | { kind: "Card"; last4: string }
  | { kind: "Cash" };

export const paymentLabel = (payment: Payment): string =>
  match (payment) {
    Card(last4) => `카드 **${last4}`,
    Cash => "현금",
  };

/* 10-d. 클래스 본문: 필드 초기화식의 result 블록, 메서드·게터의 match */

// 클래스 필드·yield 피연산자처럼 식 전용 위치의 result 블록은 로워링 말미의
// 도달 불가 `return Ok(undefined)` 안전망이 반환 유니언을 오염시켜 ts2322
// 오탐이 나므로(이슈 #12) 헬퍼 함수로 추출한다.
const openingOf = (): TResult<number, string> => result {
  const n = try half(4);
  return n * 10;
};

export class Cart {
  readonly opening: TResult<number, string> = openingOf();

  private items: number[] = [];

  add(n: number): TOption<number> {
    return match (Option.fromNullable(n > 0 ? n : null)) {
      Some(value: v) => {
        this.items.push(v);
        return Option.Some(this.items.length);
      },
      None => Option.None,
    };
  }

  get label(): string {
    return match (this.items.length) {
      0 => "빈 카트",
      _ => `${this.items.length}개`,
    };
  }
}

/* 10-e. 제너레이터: yield 피연산자의 match와 result 블록, for(val const) */

// 제너레이터 본문에서는 문 위치의 match도 전부 match-placement로 거부되므로
// (이슈 #11 — if let·파이프라인·let-else는 허용되는데 match만 전면 거부)
// match를 일반 함수로 추출한다.
const statusLineOf = (val code: number): string =>
  match (code) {
    200 => "정상",
    _ => `오류 ${code}`,
  };

export function* statusLines(codes: readonly number[]): Generator<string> {
  for (val const code of codes) {
    yield statusLineOf(code);
  }
}

const halfPlus = (n: number): TResult<number, string> => result {
  const h = try half(n);
  return h + 1;
};

export function* halves(
  ns: readonly number[],
): Generator<TResult<number, string>> {
  for (const n of ns) {
    yield halfPlus(n); // yield 피연산자의 result 블록도 이슈 #12 → 헬퍼로
  }
}

/* 10-f. catch (val e) + match, 이스케이프 리터럴 패턴과 arm 사이 주석 */

export const parsedName = (raw: string): string => {
  try {
    return (JSON.parse(raw) as { name?: string }).name ?? "무명";
  } catch (val e) {
    return match (e) {
      is SyntaxError { message } => message,
      _ => "알 수 없는 오류",
    };
  }
};

export const charClass = (ch: string): string =>
  match (ch) {
    "\n" => "개행", // 개행 문자 — arm 뒤 주석
    "\"" => "따옴표",
    /* 블록 주석도 arm 사이에 */
    "\\" => "역슬래시",
    _ => "기타",
  };

/* 10-g. let-else의 발산 else — if/else 양갈래 return, try/catch 양쪽 throw */

export const orDefault = (o: TOption<number>, fallback: number): number => {
  const Some(value: v) = o else {
    if (fallback >= 0) {
      return fallback;
    } else {
      return 0;
    }
  };
  return v + 1;
};

export const orThrow = (o: TOption<number>): number => {
  const Some(value: v) = o else {
    try {
      throw new Error("값이 없습니다");
    } catch (cause) {
      throw new Error("래핑", { cause });
    }
  };
  return v;
};

/* 10. 리터럴 or-패턴 + 가드가 섞인 match */

export const httpClass = (code: number, retried: boolean): string =>
  match (code) {
    200 | 201 | 204 => "성공",
    429 if retried => "포기",
    429 => "재시도",
    404 => "없음",
    _ => "그 외",
  };
